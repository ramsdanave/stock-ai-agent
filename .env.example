# ==========================================
# StockAI - Environment Variables
# ==========================================

# ---------- Database ----------
DB_URL=jdbc:mysql://YOUR_HOST:3306/stock_ai_db?sslMode=REQUIRED
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# ---------- Google Gemini ----------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ---------- Angel One ----------
ANGELONE_API_KEY=YOUR_ANGELONE_API_KEY
ANGELONE_CLIENT_ID=YOUR_ANGELONE_CLIENT_ID
ANGELONE_PIN=YOUR_ANGELONE_PIN
ANGELONE_TOTP_SECRET=YOUR_ANGELONE_TOTP_SECRET

# ---------- Server ----------
PORT=8080